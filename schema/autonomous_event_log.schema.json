{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autonomous Event Log",
  "type": "object",
  "required": [
    "event_id",
    "agent_id",
    "event_type",
    "timestamp"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "convoy_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "delegation_state": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}