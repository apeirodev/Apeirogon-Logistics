{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fleet Event Log",
  "type": "object",
  "required": [
    "event_id",
    "fleet_id",
    "event_type",
    "timestamp"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "fleet_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "ship_count": {
      "type": [
        "integer",
        "null"
      ]
    },
    "convoy_state": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}