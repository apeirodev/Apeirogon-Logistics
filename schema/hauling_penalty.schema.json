      "type": "string"
    },
    "canonical_name": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "operational_classification": {
      "type": "object"
    },
    "sourced_facts": {
      "type": "object"
    },
    "derived_penalties": {
      "type": "object"
    },
    "derived_operational_metrics": {
      "type": "object"
    },
    "unresolved_values": {
      "type": "array"
    },
    "runtime_dependent_values": {
      "type": "array"
    },
    "source_refs": {
      "type": "array"
    },
    "validation_status": {
      "type": "string"
    }
  }
