{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live Hauling Session Log",
  "type": "object",
  "required": [
    "session_id",
    "timestamp",
    "ship",
    "mission_batch"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "ship": {
      "type": "string"
    },
    "mission_batch": {
      "type": "array"
    },
    "route_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "ocr_confidence": {
      "type": [
        "number",
        "null"
      ]
    }
  }
}