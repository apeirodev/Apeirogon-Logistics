{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategic Event Log",
  "type": "object",
  "required": [
    "event_id",
    "campaign_id",
    "event_type",
    "timestamp"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "alliance_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "strategic_pressure": {
      "type": [
        "number",
        "null"
      ]
    }
  }
}